{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "data/league-db.json"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/programs",
      "destination": "/"
    },
    {
      "source": "/leagues",
      "destination": "/"
    },
    {
      "source": "/tournaments",
      "destination": "/"
    },
    {
      "source": "/schedule",
      "destination": "/"
    },
    {
      "source": "/teams",
      "destination": "/"
    },
    {
      "source": "/market",
      "destination": "/"
    },
    {
      "source": "/partnerships",
      "destination": "/"
    }
  ]
}
